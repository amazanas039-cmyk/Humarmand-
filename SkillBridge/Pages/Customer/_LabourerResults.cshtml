@model IEnumerable<SkillBridge.Models.Labourer>

@if (!Model.Any())
{
    <div class="empty-state text-center p-8 glass-card">
        <div class="empty-icon text-4xl text-muted mb-4">
            <i class="fa-solid fa-map-location-dot"></i>
        </div>
        <h4>No Professionals Found</h4>
        <p class="text-muted text-sm mb-0">Try expanding your search radius or changing the category filter.</p>
    </div>
}
else
{
    <div class="results-count mb-3 text-muted text-sm">
        Found @Model.Count() professionals nearby
    </div>
    
    <div class="labourer-cards d-flex flex-column gap-4">
        @foreach (var l in Model)
        {
            <div class="glass-card labourer-card d-flex gap-4 p-4 align-center" style="transition: transform 0.2s; cursor: pointer;" onclick="window.location.href='/Customer/LabourerProfile/@l.LabourerID'">
                <div class="labourer-avatar" style="width: 80px; height: 80px; border-radius: 50%; background: rgba(var(--clr-primary-rgb), 0.1); color: var(--clr-primary); display: flex; align-items: center; justify-content: center; font-size: 2rem; flex-shrink: 0;">
                    <i class="fa-solid fa-helmet-safety"></i>
                </div>
                
                <div class="labourer-info flex-grow-1">
                    <div class="d-flex justify-between align-start">
                        <div>
                            <h3 class="mb-1 text-lg">@l.FullName</h3>
                            <span class="badge badge--primary mb-2">@l.CategoryName</span>
                        </div>
                        <div class="text-right">
                            <div class="rating text-warning mb-1">
                                <i class="fa-solid fa-star"></i> @l.ReputationScore.ToString("0.0")
                            </div>
                            <small class="text-muted">@l.DistanceKm?.ToString("0.0") km away</small>
                        </div>
                    </div>
                    
                    <p class="text-sm text-muted mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        @(l.Bio ?? "Professional service provider.")
                    </p>
                    
                    <div class="d-flex justify-between align-center">
                        <span class="text-md font-bold">Rs. @l.HourlyRate.ToString("N0") <small class="text-muted font-normal">/ hr</small></span>
                        <a href="/Customer/HireRequest/@l.LabourerID" class="btn btn-outline btn-sm" onclick="event.stopPropagation();">Hire Now</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<script>
    // Update map pins when this partial loads
    if (window.updateMapPins && typeof window.updateMapPins === 'function') {
        window.updateMapPins(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(l => new { 
            id = l.LabourerID, 
            name = l.FullName, 
            cat = l.CategoryName, 
            lat = l.Latitude, 
            lng = l.Longitude, 
            rate = l.HourlyRate 
        }))));
    }
</script>
