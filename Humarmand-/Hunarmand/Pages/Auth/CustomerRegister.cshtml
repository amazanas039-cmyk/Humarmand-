@page
@model Hunarmand.Pages.Auth.CustomerRegisterModel
@{
    ViewData["Title"] = "Customer Registration";
    Layout = "_AuthLayout";
}


<div class="glass-card auth-card">

    <div class="auth-card__logo">
        <i class="fa-solid fa-users"></i>
    </div>
    <h1 class="auth-card__title">Create Account</h1>
    <p class="auth-card__subtitle">Join Hunarmand to find and hire verified service professionals</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="form-alert">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <form method="post">
        <div class="form-group">
            <label asp-for="Input.FullName">Full Name</label>
            <input asp-for="Input.FullName" class="input-field" placeholder="e.g. Ali Ahmed" required />
            <span asp-validation-for="Input.FullName" class="form-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Email">Email Address</label>
            <input asp-for="Input.Email" class="input-field" type="email" placeholder="e.g. ali@gmail.com" required />
            <span asp-validation-for="Input.Email" class="form-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Phone">Phone Number</label>
            <input asp-for="Input.Phone" class="input-field" placeholder="e.g. 03001234567" required />
            <span asp-validation-for="Input.Phone" class="form-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Address">Your Address (City/Area)</label>
            <input asp-for="Input.Address" class="input-field" placeholder="e.g. Gulberg, Lahore" required />
            <span asp-validation-for="Input.Address" class="form-error"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" class="input-field" type="password" placeholder="••••••••" required />
                <span asp-validation-for="Input.Password" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" class="input-field" type="password" placeholder="••••••••" required />
                <span asp-validation-for="Input.ConfirmPassword" class="form-error"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-full" style="margin-top: var(--space-md);">Sign Up</button>
        @Html.AntiForgeryToken()
    </form>

    <div class="auth-card__footer">
        <p>Already have an account? <a href="/Auth/CustomerLogin">Sign in here</a></p>
        <p style="margin-top: 10px; font-size: 13px;"><a href="/Auth" style="color: var(--clr-text-secondary);"><i class="fa-solid fa-arrow-left" style="margin-right: 6px;"></i>Choose another role</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
