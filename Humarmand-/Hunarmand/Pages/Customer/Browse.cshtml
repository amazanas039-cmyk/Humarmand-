@page
@model Hunarmand.Pages.Customer.BrowseModel
@{
    ViewData["Title"] = "Find Professionals";
    Layout = "_CustomerLayout";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<div class="browse-layout" style="display: grid; grid-template-columns: 300px 1fr 400px; gap: 1.5rem; height: calc(100vh - 120px);">
    
    <!-- Left: Filters panel -->
    <aside class="filters-panel glass-card d-flex flex-column" style="overflow-y: auto;">
        <h3 class="mb-4">Filters</h3>
        
        <div class="form-group">
            <button id="detectLocation" class="btn btn-outline w-100 mb-2">
                <i class="fa-solid fa-location-crosshairs"></i> Use My Location
            </button>
            <div class="text-center text-muted text-xs mb-2">OR</div>
            <input id="addressInput" placeholder="Type a city or address..." class="input-field" />
        </div>
        
        <div class="form-group mt-4">
            <label class="d-flex justify-between">
                <span>Search Radius</span>
                <span class="text-primary"><span id="radiusDisplay">10</span> km</span>
            </label>
            <input type="range" id="radiusSlider" min="1" max="50" value="10" style="width: 100%;" />
        </div>
        
        <div class="form-group mt-4">
            <label>Category</label>
            <select id="categoryFilter" class="input-field">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.CategoryID">@cat.Name</option>
                }
            </select>
        </div>
        
        <div class="form-group mt-4">
            <label class="d-flex justify-between">
                <span>Minimum Rating</span>
                <span class="text-warning"><span id="ratingDisplay">0</span> <i class="fa-solid fa-star"></i></span>
            </label>
            <input type="range" id="ratingFilter" min="0" max="5" step="0.5" value="0" style="width: 100%;" />
        </div>
        
        <div class="form-group mt-4 mb-4">
            <label>Min. Experience (Years)</label>
            <input type="number" id="expFilter" min="0" max="30" value="0" class="input-field" />
        </div>
        
        <div class="mt-auto">
            <button id="resetFilters" class="btn btn-ghost w-100">Reset Filters</button>
        </div>
    </aside>
    
    <!-- Center: Map -->
    <div class="map-container glass-card p-0" style="overflow: hidden; position: relative;">
        <div id="map" style="width: 100%; height: 100%; z-index: 1;"></div>
        <div id="mapLoading" class="glass-card" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; display: none;">
            <i class="fa-solid fa-circle-notch fa-spin text-primary"></i> Searching area...
        </div>
    </div>
    
    <!-- Right: Results -->
    <div class="results-container d-flex flex-column" style="overflow-y: auto; overflow-x: hidden;">
        <div id="resultsContent">
            <div class="empty-state text-center p-8 glass-card mt-4">
                <div class="empty-icon text-4xl text-muted mb-4">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
                <h4>Set Your Location</h4>
                <p class="text-muted text-sm mb-0">Use "My Location" or type an address to find professionals nearby.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/map-browse.js" asp-append-version="true"></script>
}
