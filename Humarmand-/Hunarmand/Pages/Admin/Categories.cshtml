@page
@model Hunarmand.Pages.Admin.CategoriesModel
@{
    ViewData["Title"] = "Categories";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <h1><i class="fa-solid fa-tags" style="color:var(--clr-primary-light);margin-right:10px;font-size:22px;"></i>Skill Categories</h1>
    <div class="admin-page-header__meta">
        <i class="fa-solid fa-circle" style="font-size:7px;color:var(--clr-success);"></i>
        <span>@Model.Categories.Count categories configured</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="admin-alert admin-alert--@Model.MessageType">
        <i class="fa-solid fa-@(Model.MessageType == "success" ? "check-circle" : "triangle-exclamation")"></i>
        @Model.Message
    </div>
}

<div style="display:grid;grid-template-columns:1fr 340px;gap:24px;">
    <!-- Category List -->
    <div class="admin-panel">
        <div class="admin-panel__header">
            <div class="admin-panel__title"><i class="fa-solid fa-list"></i> All Categories</div>
        </div>
        <div class="admin-panel__body">
            @if (!Model.Categories.Any())
            {
                <div class="admin-empty">
                    <i class="fa-solid fa-tags"></i>
                    <p>No categories found.</p>
                </div>
            }
            else
            {
                <table class="admin-table">
                    <thead>
                        <tr><th>#</th><th>Category Name</th><th>Icon</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.Categories)
                        {
                            <tr>
                                <td style="color:var(--clr-text-muted);font-size:12px;">@cat.CategoryID</td>
                                <td>
                                    <span style="width:32px;height:32px;background:rgba(124,58,237,0.15);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;margin-right:10px;">
                                        <i class="fa-solid fa-@cat.IconClass" style="color:var(--clr-primary-light);"></i>
                                    </span>
                                    <strong>@cat.Name</strong>
                                </td>
                                <td style="color:var(--clr-text-muted);font-size:12px;">fa-@cat.IconClass</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Add Category Form -->
    <div class="admin-panel">
        <div class="admin-panel__header">
            <div class="admin-panel__title"><i class="fa-solid fa-plus"></i> Add New Category</div>
        </div>
        <div style="padding:20px;">
            <form method="post" asp-page-handler="Add">
                <div class="admin-form-group">
                    <label class="admin-form-label">Category Name</label>
                    <input type="text" name="name" class="admin-form-input" placeholder="e.g. Plumbing" required />
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Font Awesome Icon Class</label>
                    <input type="text" name="iconClass" class="admin-form-input" placeholder="e.g. wrench" required />
                    <small style="color:var(--clr-text-muted);font-size:11px;">Use icon names from fontawesome.com (without fa- prefix)</small>
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Description (optional)</label>
                    <textarea name="description" class="admin-form-input" rows="3" placeholder="Brief description..."></textarea>
                </div>
                <button type="submit" class="admin-btn admin-btn--primary" style="width:100%;">
                    <i class="fa-solid fa-plus"></i> Add Category
                </button>
            </form>
        </div>
    </div>
</div>
