@page
@model Hunarmand.Pages.Admin.VerificationsModel
@{
    ViewData["Title"] = "Verifications";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <h1><i class="fa-solid fa-user-check" style="color:var(--clr-primary-light);margin-right:10px;font-size:22px;"></i>Labourer Verifications</h1>
    <div class="admin-page-header__meta">
        <i class="fa-solid fa-circle" style="font-size:7px;color:var(--clr-warning);"></i>
        <span>@Model.Pending.Count awaiting review</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="admin-alert admin-alert--@Model.MessageType">
        <i class="fa-solid fa-@(Model.MessageType == "success" ? "check-circle" : "triangle-exclamation")"></i>
        @Model.Message
    </div>
}

<div class="admin-panel">
    <div class="admin-panel__header">
        <div class="admin-panel__title"><i class="fa-solid fa-user-clock"></i> Pending Verification Requests</div>
    </div>
    <div class="admin-panel__body">
        @if (!Model.Pending.Any())
        {
            <div class="admin-empty">
                <i class="fa-solid fa-circle-check" style="color:var(--clr-success);"></i>
                <p>All caught up! No pending verifications.</p>
            </div>
        }
        else
        {
            @foreach (var l in Model.Pending)
            {
                <div class="admin-verification-card">
                    <div class="admin-verification-card__header">
                        <span class="admin-table__avatar" style="width:44px;height:44px;font-size:18px;background:linear-gradient(135deg,#7C3AED,#A855F7)">@(l.FullName?[0])</span>
                        <div>
                            <div style="font-weight:700;color:var(--clr-text-primary);">@l.FullName</div>
                            <div style="font-size:12px;color:var(--clr-text-muted);">@l.Email &bull; @l.Phone</div>
                        </div>
                        <span class="badge badge--warning" style="margin-left:auto;"><i class="fa-solid fa-clock"></i> Pending</span>
                    </div>
                    <div class="admin-verification-card__body">
                        <div class="admin-verification-card__detail"><span>Category</span><strong>@l.CategoryName</strong></div>
                        <div class="admin-verification-card__detail"><span>Experience</span><strong>@l.ExperienceYears years</strong></div>
                        <div class="admin-verification-card__detail"><span>Rate</span><strong>Rs @l.HourlyRate/hr</strong></div>
                        <div class="admin-verification-card__detail"><span>Applied</span><strong>@l.CreatedAt.ToString("MMM dd, yyyy")</strong></div>
                    </div>
                    @if (!string.IsNullOrEmpty(l.Bio))
                    {
                        <div style="padding:0 20px 12px;font-size:13px;color:var(--clr-text-secondary);">
                            <strong style="color:var(--clr-text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.05em;">Bio</strong><br />
                            @l.Bio
                        </div>
                    }
                    <div class="admin-verification-card__actions">
                        <form method="post" asp-page-handler="Approve" style="display:inline;">
                            <input type="hidden" name="labourerId" value="@l.LabourerID" />
                            <input type="hidden" name="note" value="Profile verified and approved by admin." />
                            <button type="submit" class="admin-btn admin-btn--success" id="approve-@l.LabourerID">
                                <i class="fa-solid fa-check"></i> Approve
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Reject" style="display:inline;" onsubmit="return confirmReject(this)">
                            <input type="hidden" name="labourerId" value="@l.LabourerID" />
                            <input type="hidden" name="note" id="rejectNote-@l.LabourerID" value="" />
                            <button type="submit" class="admin-btn admin-btn--danger" id="reject-@l.LabourerID">
                                <i class="fa-solid fa-xmark"></i> Reject
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
<script>
function confirmReject(form) {
    const note = prompt('Enter rejection reason:');
    if (!note || note.trim() === '') return false;
    form.querySelector('input[name="note"]').value = note;
    return true;
}
</script>
}
