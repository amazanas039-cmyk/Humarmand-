@page
@model Hunarmand.Pages.Labourer.DashboardModel
@{
    ViewData["Title"] = "Professional Dashboard";
    Layout = "_LabourerLayout";
}

<div class="dashboard-header animate-fade-up">
    <div>
        <h1>Welcome, @Model.ProfessionalName 🛠️</h1>
        <p class="text-muted">Here's your professional overview for the last 30 days.</p>
    </div>
</div>

<div class="stats-grid mt-6 animate-fade-up" style="animation-delay: 0.1s; grid-template-columns: repeat(4, 1fr);">
    <div class="glass-card stat-card">
        <div class="stat-card__icon" style="background: rgba(245, 158, 11, 0.1); color: var(--clr-warning);">
            <i class="fa-solid fa-star"></i>
        </div>
        <div class="stat-card__info">
            <p class="text-sm text-muted">Reputation</p>
            <h3>@Model.DashboardData.ReputationScore.ToString("0.0")</h3>
            <small class="@(Model.DashboardData.ReputationDelta >= 0 ? "text-success" : "text-danger")">
                <i class="fa-solid @(Model.DashboardData.ReputationDelta >= 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                @Math.Abs(Model.DashboardData.ReputationDelta).ToString("0.0") this month
            </small>
        </div>
    </div>
    <div class="glass-card stat-card">
        <div class="stat-card__icon" style="background: rgba(16, 185, 129, 0.1); color: var(--clr-success);">
            <i class="fa-solid fa-money-bill-wave"></i>
        </div>
        <div class="stat-card__info">
            <p class="text-sm text-muted">This Month</p>
            <h3>Rs. @Model.DashboardData.EarningsThisMonth.ToString("N0")</h3>
            <small class="text-muted">Est. Earnings</small>
        </div>
    </div>
    <div class="glass-card stat-card">
        <div class="stat-card__icon" style="background: rgba(59, 130, 246, 0.1); color: var(--clr-info);">
            <i class="fa-solid fa-bullseye"></i>
        </div>
        <div class="stat-card__info">
            <p class="text-sm text-muted">Completion Rate</p>
            <h3>@Model.DashboardData.CompletionRate.ToString("0")%</h3>
            <small class="text-muted">Of accepted jobs</small>
        </div>
    </div>
    <div class="glass-card stat-card">
        <div class="stat-card__icon" style="background: rgba(124, 58, 237, 0.1); color: var(--clr-primary);">
            <i class="fa-solid fa-clipboard-list"></i>
        </div>
        <div class="stat-card__info">
            <p class="text-sm text-muted">Active Jobs</p>
            <h3>@Model.DashboardData.ActiveRequests</h3>
            <small class="text-muted">In progress</small>
        </div>
    </div>
</div>

<div class="dashboard-grid mt-8 animate-fade-up" style="animation-delay: 0.2s;">
    <div class="glass-card">
        <h3 class="mb-4">Earnings Over Time</h3>
        <canvas id="earningsChart" height="250"></canvas>
    </div>
    <div class="glass-card">
        <h3 class="mb-4">Job Funnel</h3>
        <canvas id="funnelChart" height="250"></canvas>
    </div>
</div>

<div class="dashboard-grid mt-8 animate-fade-up" style="animation-delay: 0.3s; display: grid; grid-template-columns: 2fr 1fr; gap: 2rem;">
    <div class="glass-card">
        <div class="card-header d-flex justify-between align-center mb-4">
            <h3 class="mb-0">Recent Requests</h3>
            <a href="/Labourer/Jobs" class="text-primary text-sm">View All</a>
        </div>
        
        @if (!Model.DashboardData.RecentRequests.Any())
        {
            <div class="empty-state text-center p-8">
                <p class="text-muted mb-0">No recent requests.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="admin-table w-100">
                    <thead>
                        <tr>
                            <th>Job ID</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.DashboardData.RecentRequests)
                        {
                            <tr>
                                <td>#@job.RequestID</td>
                                <td>@job.CustomerName</td>
                                <td>@job.PreferredDate.ToString("MMM dd")</td>
                                <td><span class="badge badge--@(job.Status == "Pending" ? "warning" : "primary")">@job.Status</span></td>
                                <td><a href="/Labourer/JobDetail/@job.RequestID" class="btn btn-sm btn-ghost">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="glass-card">
        <h3 class="mb-4">Recent Reviews</h3>
        @if (!Model.RecentReviews.Any())
        {
            <p class="text-muted text-center py-4">No reviews yet.</p>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var review in Model.RecentReviews.Take(3))
                {
                    <div class="review-item p-3 rounded" style="background: rgba(var(--clr-surface-rgb), 0.5);">
                        <div class="d-flex justify-between mb-2">
                            <strong>@review.ReviewerName</strong>
                            <span class="text-warning"><i class="fa-solid fa-star"></i> @review.Rating</span>
                        </div>
                        <p class="text-sm text-muted mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            "@review.Comment"
                        </p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/charts-labourer.js" asp-append-version="true"></script>
    <script>
        // Pass JSON data to the charts script
        window.dashboardData = {
            earnings: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.EarningsTrend)),
            funnel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.Funnel))
        };
        if(typeof initLabourerCharts === 'function') {
            initLabourerCharts(window.dashboardData);
        }
    </script>
}
