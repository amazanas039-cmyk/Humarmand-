@page
@model IndexModel
@{
    ViewData["Title"] = "Hunarmand - Connecting Skill to Need";
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<div class="aurora-bg">
    <div class="aurora-orb aurora-orb--1"></div>
    <div class="aurora-orb aurora-orb--2"></div>
    <div class="aurora-orb aurora-orb--3"></div>
</div>

<!-- SECTION 1: HERO -->
<section id="hero" class="hero-section">
    <div class="container hero-grid">
        <div class="hero-content animate-fade-up">
            <h1 class="hero-title">Find Skilled Workers, <br /><span class="grad-text">Instantly.</span></h1>
            <p class="hero-subtitle">Hunarmand Hunarmand connects Pakistani households and businesses with trusted, admin-verified local laborers. Standardized pricing, transparent reviews, and zero hassle.</p>
            <div class="hero-ctas">
                <a href="/Customer/Browse" class="btn btn-primary">Hire a Professional <i class="fa-solid fa-arrow-right"></i></a>
                <a href="/Auth" class="btn btn-outline">Register as Laborer</a>
            </div>
            <div class="hero-social-proof">
                <div class="avatar-stack">
                    <div class="avatar-stack-placeholder avatar-stack-placeholder--1">A</div>
                    <div class="avatar-stack-placeholder avatar-stack-placeholder--2">K</div>
                    <div class="avatar-stack-placeholder avatar-stack-placeholder--3">M</div>
                    <div class="avatar-stack-placeholder avatar-stack-placeholder--4">S</div>
                </div>
                <p class="social-proof-text">Join over <strong>2,000+</strong> users and verified workers today.</p>
            </div>
        </div>
        
        <div class="hero-mockup-container animate-fade-up delay-200">
            <div class="dashboard-mockup glass-card animate-glow">
                <div class="mockup-header">
                    <div class="mockup-window-controls">
                        <span class="mockup-dot mockup-dot--red"></span>
                        <span class="mockup-dot mockup-dot--yellow"></span>
                        <span class="mockup-dot mockup-dot--green"></span>
                    </div>
                    <div class="mockup-title">HUNARMAND DASHBOARD PREVIEW</div>
                </div>
                <div class="mockup-stats-grid">
                    <div class="mockup-mini-card">
                        <div class="label"><i class="fa-solid fa-users"></i> Users Online</div>
                        <div class="val grad-text">148</div>
                    </div>
                    <div class="mockup-mini-card">
                        <div class="label"><i class="fa-solid fa-star"></i> Avg Rating</div>
                        <div class="val grad-text">4.8★</div>
                    </div>
                </div>
                <div class="mockup-jobs-list">
                    <div class="mockup-job-item">
                        <div>
                            <div class="mockup-job-title">AC Installation</div>
                            <div class="mockup-job-worker">Muhammad Ali (Electrician)</div>
                        </div>
                        <span class="badge badge-success">Active</span>
                    </div>
                    <div class="mockup-job-item">
                        <div>
                            <div class="mockup-job-title">Leakage Repair</div>
                            <div class="mockup-job-worker">Sajid Mahmood (Plumber)</div>
                        </div>
                        <span class="badge badge-warning">Accepted</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- SECTION 2: HOW IT WORKS -->
<section id="how-it-works" class="section section-alt">
    <div class="container">
        <div class="section-header animate-fade-up">
            <span class="section-tag">Process</span>
            <h2 class="section-title">Get work done in 3 simple steps</h2>
        </div>
        
        <div class="how-it-works-grid">
            <div class="step-card glass-card animate-fade-up delay-100">
                <div class="step-number">1</div>
                <div class="step-icon"><i class="fa-solid fa-briefcase"></i></div>
                <h3>Post Your Job</h3>
                <p>Describe your job requirement, set your preferred date and time, and share your map location pin.</p>
            </div>
            
            <div class="step-card glass-card animate-fade-up delay-200">
                <div class="step-number">2</div>
                <div class="step-icon"><i class="fa-solid fa-magnifying-glass-location"></i></div>
                <h3>Browse & Match</h3>
                <p>Use our smart ranking proximity filter to select top-rated, nearby labor within an adjustable distance radius.</p>
            </div>
            
            <div class="step-card glass-card animate-fade-up delay-300">
                <div class="step-number">3</div>
                <div class="step-icon"><i class="fa-solid fa-handshake"></i></div>
                <h3>Hire & Complete</h3>
                <p>Track request status in real-time, resolve disputes via live mediation if needed, and complete payments securely.</p>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 3: SKILL CATEGORIES -->
<section id="categories" class="section">
    <div class="container">
        <div class="section-header animate-fade-up">
            <span class="section-tag">Expertise</span>
            <h2 class="section-title">Find professionals for every job</h2>
        </div>
        
        <div class="category-grid">
            @foreach (var cat in Model.Categories)
            {
                <a href="/Customer/Browse?categoryId=@cat.CategoryID" class="category-card glass-card animate-fade-up">
                    <div class="category-icon">
                        <i class="@cat.IconClass"></i>
                    </div>
                    <div class="category-info">
                        <h3>@cat.Name</h3>
                        <p>@cat.Description</p>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- STATS COUNTER BANNER -->
<section class="stats-banner">
    <div class="container stats-banner__grid">
        <div class="stat-item">
            <h2 class="counter-value" data-target="2000">2,000+</h2>
            <p>Active Users</p>
        </div>
        <div class="stat-item">
            <h2 class="counter-value" data-target="500">500+</h2>
            <p>Verified Workers</p>
        </div>
        <div class="stat-item">
            <h2 class="counter-value" data-target="4800">4,800+</h2>
            <p>Jobs Completed</p>
        </div>
    </div>
</section>

<!-- SECTION 4: FEATURED LABOURERS -->
<section id="featured" class="section section-alt">
    <div class="container">
        <div class="section-header animate-fade-up">
            <span class="section-tag">Hunarmands</span>
            <h2 class="section-title">Top rated experts in Lahore</h2>
        </div>
        
        <div class="grid-4">
            @foreach (var l in Model.FeaturedLabourers)
            {
                <div class="worker-card glass-card animate-fade-up">
                    <div class="worker-card__header">
                        <div class="worker-card__avatar">
                            <i class="fa-solid fa-user-gear"></i>
                        </div>
                        <div class="worker-card__info">
                            <h4>@l.FullName</h4>
                            <div class="worker-card__rating">
                                <i class="fa-solid fa-star"></i>
                                <span>@l.ReputationScore (@l.CompletionRate% completion)</span>
                            </div>
                        </div>
                    </div>
                    <div class="worker-card__bio">@l.Bio</div>
                    <div class="worker-card__footer">
                        <div class="worker-card__rate">
                            Rs. @l.HourlyRate <span>/ hr</span>
                        </div>
                        <a href="/Customer/Browse?categoryId=@l.CategoryID" class="btn btn-outline btn-sm">Hire Now</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- TESTIMONIALS SECTION -->
<section id="testimonials" class="section">
    <div class="container">
        <div class="section-header animate-fade-up">
            <span class="section-tag">Testimonials</span>
            <h2 class="section-title">Loved by customers across Pakistan</h2>
        </div>
        
        <div class="testimonials-grid">
            <div class="testimonial-card glass-card animate-fade-up">
                <p class="testimonial-text">"Finding an electrician in Lahore Gulberg area used to take hours of asking neighbors. Through Hunarmand, I hired Ali who arrived in 20 minutes and fixed our short circuit immediately. Amazing service!"</p>
                <div class="testimonial-user">
                    <div class="testimonial-avatar" style="background:#7C3AED">AM</div>
                    <div class="testimonial-meta">
                        <h4>Ayesha Malik</h4>
                        <p>Gulberg III, Lahore</p>
                    </div>
                </div>
            </div>
            
            <div class="testimonial-card glass-card animate-fade-up delay-100">
                <p class="testimonial-text">"As a plumber, getting consistent work was difficult. Since getting verified on Hunarmand Hunarmand, my phone doesn't stop ringing. The earnings dashboard helps me track my monthly progress perfectly."</p>
                <div class="testimonial-user">
                    <div class="testimonial-avatar" style="background:#059669">SM</div>
                    <div class="testimonial-meta">
                        <h4>Sajid Mahmood</h4>
                        <p>Model Town, Lahore</p>
                    </div>
                </div>
            </div>
            
            <div class="testimonial-card glass-card animate-fade-up delay-200">
                <p class="testimonial-text">"The dispute center and live mediator chat gave me absolute confidence. When the AC technician didn't install the brackets properly, the admin sorted it out with both of us in real-time."</p>
                <div class="testimonial-user">
                    <div class="testimonial-avatar" style="background:#2563EB">FH</div>
                    <div class="testimonial-meta">
                        <h4>Farhan Hashmi</h4>
                        <p>DHA Phase 5, Lahore</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 5: CTA BANNER -->
<section class="cta-section">
    <div class="container">
        <div class="cta-banner">
            <h2>Ready to experience better hiring?</h2>
            <p>Connect with admin-verified local talent or grow your service business on Hunarmand Hunarmand today.</p>
            <div>
                <a href="/Auth" class="btn">Get Started Now <i class="fa-solid fa-arrow-right"></i></a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Count-up animation for stats counter
        document.addEventListener('DOMContentLoaded', () => {
            const counters = document.querySelectorAll('.counter-value');
            
            const animateCounter = (counter) => {
                const target = parseInt(counter.getAttribute('data-target'));
                let current = 0;
                const duration = 1200; // ms
                const stepTime = 15;
                const steps = duration / stepTime;
                const increment = target / steps;
                
                counter.classList.add('counted');
                
                const timer = setInterval(() => {
                    current += increment;
                    if (current >= target) {
                        counter.textContent = target.toLocaleString() + '+';
                        clearInterval(timer);
                    } else {
                        counter.textContent = Math.floor(current).toLocaleString() + '+';
                    }
                }, stepTime);
            };

            // Trigger when visible in viewport
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting && !entry.target.classList.contains('counted')) {
                        animateCounter(entry.target);
                    }
                });
            }, { threshold: 0.5 });

            counters.forEach(counter => observer.observe(counter));
        });
    </script>
}
