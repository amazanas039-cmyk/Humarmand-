<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hunarmand</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- CSS libraries -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Custom Design System CSS -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    
    <!-- Theme loading script (blocking in head to avoid flicker) -->
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="navbar__container">
                <a class="navbar__logo" href="/">
                    <i class="fa-solid fa-hard-hat"></i>
                    <span>Hunarmand</span>
                </a>
                
                <ul class="navbar__menu">
                    <li><a class="navbar__link" href="/#hero">Home</a></li>
                    <li><a class="navbar__link" href="/#how-it-works">How It Works</a></li>
                    <li><a class="navbar__link" href="/#categories">Browse Skills</a></li>
                    <li><a class="navbar__link" href="/Auth">Login</a></li>
                </ul>
                
                <div class="navbar__actions">
                    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle Light/Dark Theme">
                        <i class="fa-solid fa-moon"></i>
                    </button>
                    <a href="/Auth" class="btn btn-primary btn-sm">Get Started</a>
                    <button class="navbar__hamburger" aria-label="Open navigation menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer__grid">
                <div class="footer__brand">
                    <a class="footer__logo" href="/">
                        <i class="fa-solid fa-hard-hat"></i>
                        <span>Hunarmand</span>
                    </a>
                    <p class="footer__tagline">Connecting Skill to Need. Hunarmand is Pakistan's leading on-demand labor-hiring platform connecting you to verified local professionals.</p>
                    <div class="footer__socials">
                        <a href="#" class="footer__social-link" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" class="footer__social-link" aria-label="Twitter"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#" class="footer__social-link" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                    </div>
                </div>
                
                <div class="footer__links-col">
                    <h4>Quick Links</h4>
                    <ul class="footer__links">
                        <li><a href="/#hero" class="footer__link">Home</a></li>
                        <li><a href="/#how-it-works" class="footer__link">How It Works</a></li>
                        <li><a href="/#categories" class="footer__link">Browse Categories</a></li>
                        <li><a href="/Auth" class="footer__link">Sign In</a></li>
                    </ul>
                </div>
                
                <div class="footer__links-col">
                    <h4>Support & Trust</h4>
                    <ul class="footer__links">
                        <li><a href="#" class="footer__link">Trust & Safety</a></li>
                        <li><a href="#" class="footer__link">Dispute Center</a></li>
                        <li><a href="#" class="footer__link">Terms of Service</a></li>
                        <li><a href="#" class="footer__link">Privacy Policy</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="footer__bottom">
                <p class="footer__copy">&copy; @DateTime.Now.Year Hunarmand Hunarmand. All rights reserved.</p>
                <div class="footer__bottom-links">
                    <a href="#" class="footer__link">Privacy</a>
                    <a href="#" class="footer__link">Terms</a>
                    <a href="#" class="footer__link">Contact</a>
                </div>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
